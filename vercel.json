{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/gallery/",
      "destination": "/gallery.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    }
  ],
  "framework": null,
  "buildCommand": "cd new-admin && npm ci && npm run build && cd .. && mkdir -p public/admin && cp -r new-admin/dist/. public/admin/",
  "installCommand": "npm install --no-audit --no-fund",
  "outputDirectory": "public"
}
