{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/gallery/",
      "destination": "/gallery.html"
    },
    {
      "source": "/admin",
      "destination": "https://breadoflifedcm.gandjtechhub.chatgpt.site/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://breadoflifedcm.gandjtechhub.chatgpt.site/admin/:path*"
    },
    {
      "source": "/api/admin",
      "destination": "https://breadoflifedcm.gandjtechhub.chatgpt.site/api/admin"
    },
    {
      "source": "/api/admin-login",
      "destination": "https://breadoflifedcm.gandjtechhub.chatgpt.site/api/admin-login"
    },
    {
      "source": "/api/admin-logout",
      "destination": "https://breadoflifedcm.gandjtechhub.chatgpt.site/api/admin-logout"
    },
    {
      "source": "/signin-with-chatgpt",
      "destination": "https://breadoflifedcm.gandjtechhub.chatgpt.site/signin-with-chatgpt"
    },
    {
      "source": "/signout-with-chatgpt",
      "destination": "https://breadoflifedcm.gandjtechhub.chatgpt.site/signout-with-chatgpt"
    },
    {
      "source": "/callback",
      "destination": "https://breadoflifedcm.gandjtechhub.chatgpt.site/callback"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://breadoflifedcm.gandjtechhub.chatgpt.site/api/admin/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://breadoflifedcm.gandjtechhub.chatgpt.site/media/:path*"
    }
  ],
  "framework": null,
  "buildCommand": "echo static site",
  "installCommand": "echo skip",
  "outputDirectory": "public"
}
