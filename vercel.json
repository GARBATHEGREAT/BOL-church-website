{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/gallery/",
      "destination": "/gallery.html"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/media/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    }
  ],
  "framework": null,
  "buildCommand": "cd new-admin && npm ci && npm run build && cd .. && mkdir -p public/admin && cp -r new-admin/dist/. public/admin/",
  "installCommand": "echo skip",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
