{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/public/home.html" },
    { "source": "/site-settings.js", "destination": "/public/site-settings.js" },
    { "source": "/assets/:path*", "destination": "/public/assets/:path*" }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://breadoflifedcm.gandjtechhub.chatgpt.site/admin",
      "permanent": false
    }
  ]
}
