# Copy to .env and fill in. Never commit .env.
ADMIN_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=choose-a-long-random-password
ADMIN_SESSION_SECRET=generate-a-long-random-string
# Database: local file by default; use Turso (libSQL) in production.
TURSO_DATABASE_URL=file:./data/church.db
TURSO_AUTH_TOKEN=
# Media: local folder by default; set both for Vercel Blob in production.
MEDIA_DIR=./data/media
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_URL=
API_PORT=8787
