{
  "name": "bol-church-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone admin and data API for the Bread of Life website (no ChatGPT platform dependency).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx --env-file=.env server/dev.ts",
    "dev:web": "vite",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "build": "vite build",
    "import:live": "tsx --env-file=.env scripts/import-live.ts",
    "test": "tsx --env-file=.env scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "@vercel/blob": "^1.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "npm-run-all2": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
